# Backend local. Không đưa key này vào frontend/web hoặc frontend/app.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Chưa có Translator vẫn thử Tạo giọng đọc/OCR được; Dịch và đọc báo chưa cấu hình.
AZURE_TRANSLATOR_KEY=
# Dùng Location của resource Translator: East Asia = eastasia; chỉ dùng global nếu resource ở Global.
AZURE_TRANSLATOR_REGION=global

# Tùy chọn: chỉ bật khi có key/model Gemini được tài khoản hỗ trợ.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TYPO_ENABLED=false
GEMINI_TIMEOUT_SECONDS=8
GEMINI_TRANSLATION_ENABLED=false
GEMINI_EMOTION_ENABLED=false
GEMINI_OCR_ENABLED=false
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
OCR_DAILY_CALL_LIMIT=100

# Gemini trực tiếp tạo giọng, dùng GEMINI_API_KEY ở trên; độc lập model OCR/dịch.
GEMINI_TTS_ENABLED=false
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_DAILY_CALL_LIMIT=100

# Mã thử local, nhập tại Cài đặt của web/app. Đổi nếu mở API cho thiết bị trên LAN.
DEMO_TOKEN=local-demo
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8000
LOCAL_PUBLIC_URL=http://127.0.0.1:8000
MAX_CHARS=10000
DAILY_CHAR_LIMIT=30000
