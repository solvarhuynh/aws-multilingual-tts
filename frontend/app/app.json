{
  "expo": {
    "name": "TTS Studio",
    "slug": "hcmute-tts-studio",
    "scheme": "hcmute-tts",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.hcmute.ttsstudio"
    },
    "android": {
      "package": "vn.edu.hcmute.ttsstudio",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/brand/hcmute.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cho phép dùng camera để quét tài liệu thành văn bản.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
