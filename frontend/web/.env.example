# Sao chép thành .env.local, rồi thay bằng domain CloudFront của phiên lab hiện tại.
# Chỉ đặt URL công khai ở đây. Mã demo nhập trong Cài đặt của web.
VITE_API_BASE_URL=https://YOUR-DISTRIBUTION.cloudfront.net
# Chỉ dùng khi chạy Vite local để thử Gemini mà chưa có AWS. Key nhập ở terminal Python.
# VITE_LOCAL_AI_BASE_URL=http://127.0.0.1:8765
